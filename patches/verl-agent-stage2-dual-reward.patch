diff --git a/tests_stage2/test_futile_tracker_cpu.py b/tests_stage2/test_futile_tracker_cpu.py
new file mode 100644
index 0000000..5fa382e
--- /dev/null
+++ b/tests_stage2/test_futile_tracker_cpu.py
@@ -0,0 +1,320 @@
+"""CPU integration test for the Stage 2 futile-repetition tracker.
+
+Drives the real ALFWorld env worker (AlfworldWorker in agent_system/
+environments/env_package/alfworld/envs.py — the exact class AlfworldEnvs
+wraps with ray.remote) through scripted action sequences and asserts the
+tracker contract exposed by the env worker: info['futile'] (bool) and
+info['futile_streak'] (int, consecutive-futile streak index, 0 when not
+futile).
+
+Deliberately Ray-free: ray.remote is applied to AlfworldWorker only inside
+AlfworldEnvs, so instantiating the worker directly exercises the identical
+step()/reset() code without starting a Ray cluster (which a live training
+run may already own on this machine).
+
+Patterns (from the validated Stage 2 design):
+  (a) examine X twice with nothing between -> 2nd flagged (streak 1);
+      third -> streak 2;
+  (b) examine A -> visit/open B elsewhere -> return -> examine A again ->
+      flagged (a round trip does not exempt);
+  (c) take an object from receptacle R -> examine R again -> NOT flagged
+      (R's entity slice changed);
+  (d) first-time failed/no-op action -> never flagged on first execution;
+  (e) a no-op 'open X' from the wrong position, retried after 'go to X',
+      is NOT flagged (the agent's position is part of every entity slice).
+
+Suitable entities are discovered at runtime from admissible commands; if a
+sampled game cannot express pattern (b), (c) or (e) after a few episodes the
+pattern is skipped with a message. Patterns (a) and (d) must always run;
+failure to set them up counts as FAIL.
+
+Run with:
+  CUDA_VISIBLE_DEVICES="" ALFWORLD_DATA=/home/yuhan/.cache/alfworld \
+    /home/yuhan/verl-agent/.venv/bin/python \
+    /home/yuhan/verl-agent/tests_stage2/test_futile_tracker_cpu.py
+"""
+import os
+import sys
+
+os.environ.setdefault("ALFWORLD_DATA", "/home/yuhan/.cache/alfworld")
+os.environ["CUDA_VISIBLE_DEVICES"] = ""
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, REPO_ROOT)
+
+from agent_system.environments.env_package.alfworld.envs import (  # noqa: E402
+    AlfworldWorker,
+    compute_reward,
+    load_config_file,
+)
+from agent_system.environments.env_package.alfworld.alfworld.agents.environment import (  # noqa: E402
+    get_environment,
+)
+
+CONFIG_PATH = os.path.join(
+    REPO_ROOT, "agent_system/environments/env_package/alfworld/configs/config_tw.yaml"
+)
+MAX_GAMES = 6          # episodes to try per pattern before giving up
+MAX_RECEPTACLES = 8    # go-to targets to probe within one episode
+
+
+class TrackerKeysMissing(Exception):
+    pass
+
+
+class SingleEnv:
+    """Drives one real AlfworldWorker directly (no Ray), unwrapping the
+    per-key [0] lists exactly as AlfworldEnvs.step/reset do."""
+
+    def __init__(self, seed=0):
+        config = load_config_file(CONFIG_PATH)
+        env_type = config["env"]["type"]
+        base_env = get_environment(env_type)(config, train_eval="train")
+        self.worker = AlfworldWorker(config, seed, base_env)
+
+    @staticmethod
+    def _unwrap(info):
+        return {k: v[0] for k, v in info.items()}
+
+    def reset(self):
+        obs, infos = self.worker.reset()
+        info = self._unwrap(infos)
+        return obs[0], info
+
+    def step(self, action):
+        obs, scores, dones, infos = self.worker.step(action)
+        info = self._unwrap(infos)
+        return obs[0], compute_reward(info, multi_modal=False), dones[0], info
+
+    def close(self):
+        close = getattr(self.worker.env, "close", None)
+        if close is not None:
+            close()
+
+
+def admissible(info):
+    return list(info.get("admissible_commands", []))
+
+
+def goto_targets(info):
+    return [c[len("go to "):] for c in admissible(info) if c.startswith("go to ")]
+
+
+def futile_of(info):
+    if "futile" not in info or "futile_streak" not in info:
+        raise TrackerKeysMissing(
+            "info dict lacks 'futile'/'futile_streak' — tracker not wired into "
+            "the env worker (keys present: %s)" % sorted(info.keys())
+        )
+    return bool(info["futile"]), int(info["futile_streak"])
+
+
+def find_examinable_receptacle(env, info):
+    """Walk go-to targets until one whose 'examine <t>' is admissible on
+    arrival. Returns (target, info, done); target is None if none found."""
+    done = False
+    for t in goto_targets(info)[:MAX_RECEPTACLES]:
+        _, _, done, info = env.step(f"go to {t}")
+        if done:
+            return None, info, done
+        if f"examine {t}" in admissible(info):
+            return t, info, done
+    return None, info, done
+
+
+def pattern_a(env):
+    """examine X three times: 1st clean, 2nd futile streak 1, 3rd streak 2."""
+    for _ in range(MAX_GAMES):
+        _, info = env.reset()
+        target, info, done = find_examinable_receptacle(env, info)
+        if target is None or done:
+            continue
+        exam = f"examine {target}"
+        _, _, done, info = env.step(exam)
+        f1, s1 = futile_of(info)
+        if f1 or s1 != 0:
+            return f"FAIL: first '{exam}' flagged (futile={f1}, streak={s1})"
+        if done:
+            continue
+        _, _, done, info = env.step(exam)
+        f2, s2 = futile_of(info)
+        if not (f2 and s2 == 1):
+            return f"FAIL: second '{exam}' expected futile streak 1, got (futile={f2}, streak={s2})"
+        if done:
+            continue
+        _, _, done, info = env.step(exam)
+        f3, s3 = futile_of(info)
+        if not (f3 and s3 == 2):
+            return f"FAIL: third '{exam}' expected futile streak 2, got (futile={f3}, streak={s3})"
+        return "PASS"
+    return f"FAIL: no examinable receptacle found in {MAX_GAMES} games (pattern must run)"
+
+
+def pattern_b(env):
+    """examine A -> detour to B (open it if possible) -> return -> examine A
+    again: still flagged, the round trip does not exempt (the agent is back
+    at A, so its position matches the recorded no-op slice)."""
+    for _ in range(MAX_GAMES):
+        _, info = env.reset()
+        all_targets = goto_targets(info)
+        if len(all_targets) < 2:
+            continue
+        a, info, done = find_examinable_receptacle(env, info)
+        if a is None or done:
+            continue
+        _, _, done, info = env.step(f"examine {a}")
+        fa, sa = futile_of(info)
+        if fa:
+            return f"FAIL: first 'examine {a}' flagged (futile={fa}, streak={sa})"
+        if done:
+            continue
+        b = next((t for t in all_targets if t != a), None)
+        _, _, done, info = env.step(f"go to {b}")
+        if done:
+            continue
+        if f"open {b}" in admissible(info):
+            _, _, done, info = env.step(f"open {b}")
+            if done:
+                continue
+        _, _, done, info = env.step(f"go to {a}")
+        if done:
+            continue
+        _, _, _, info = env.step(f"examine {a}")
+        f, s = futile_of(info)
+        if f and s == 1:
+            return "PASS"
+        return f"FAIL: 'examine {a}' after round trip expected futile streak 1, got (futile={f}, streak={s})"
+    return f"SKIP: no game with two receptacles and an examinable A in {MAX_GAMES} games"
+
+
+def pattern_c(env):
+    """examine R -> take an object from R -> examine R again: NOT flagged,
+    because R's entity slice (contents + inventory) changed."""
+    for _ in range(MAX_GAMES):
+        _, info = env.reset()
+        done = False
+        for t in goto_targets(info)[:MAX_RECEPTACLES]:
+            _, _, done, info = env.step(f"go to {t}")
+            if done:
+                break
+            if f"open {t}" in admissible(info):
+                _, _, done, info = env.step(f"open {t}")
+                if done:
+                    break
+            exam = f"examine {t}"
+            takes = [
+                c for c in admissible(info)
+                if c.startswith("take ") and c.endswith(f" from {t}")
+            ]
+            if not takes or exam not in admissible(info):
+                continue
+            _, _, done, info = env.step(exam)
+            f1, s1 = futile_of(info)
+            if f1:
+                return f"FAIL: first '{exam}' flagged (futile={f1}, streak={s1})"
+            if done:
+                break
+            _, _, done, info = env.step(takes[0])
+            if done:
+                break
+            _, _, _, info = env.step(exam)
+            f2, s2 = futile_of(info)
+            if not f2 and s2 == 0:
+                return "PASS"
+            return f"FAIL: '{exam}' after '{takes[0]}' flagged (futile={f2}, streak={s2}) though slice changed"
+    return f"SKIP: no receptacle with a takeable object found in {MAX_GAMES} games"
+
+
+def pattern_d(env):
+    """A first-time failed/no-op action is never flagged."""
+    for _ in range(MAX_GAMES):
+        _, info = env.reset()
+        targets = goto_targets(info)
+        if not targets:
+            continue
+        # Examining a receptacle we are not at yields "Nothing happens" — a
+        # genuine first-time failed action on a real entity. If every examine
+        # happens to be admissible, the first (state no-op) execution still
+        # must not be flagged.
+        cand = next(
+            (f"examine {t}" for t in targets if f"examine {t}" not in admissible(info)),
+            f"examine {targets[0]}",
+        )
+        _, _, _, info = env.step(cand)
+        f, s = futile_of(info)
+        if not f and s == 0:
+            return "PASS"
+        return f"FAIL: first-time no-op '{cand}' flagged (futile={f}, streak={s})"
+    return f"FAIL: no go-to targets in {MAX_GAMES} games (pattern must run)"
+
+
+def pattern_e(env):
+    """'open X' from the wrong position ('Nothing happens'), then 'go to X'
+    and retry: the retry succeeds and must NOT be flagged — the agent's
+    position is part of the entity slice, so the recorded no-op slice no
+    longer matches."""
+    for _ in range(MAX_GAMES):
+        obs, info = env.reset()
+        done = False
+        for t in goto_targets(info)[:MAX_RECEPTACLES]:
+            obs, _, done, info = env.step(f"open {t}")
+            if done:
+                break
+            f0, s0 = futile_of(info)
+            if f0:
+                return f"FAIL: first-time 'open {t}' from afar flagged (futile={f0}, streak={s0})"
+            if not str(obs).strip().startswith("Nothing happens"):
+                continue  # not a no-op from here; try another receptacle
+            obs, _, done, info = env.step(f"go to {t}")
+            if done:
+                break
+            if f"open {t}" not in admissible(info):
+                continue  # not openable (or already open); try another
+            obs, _, done, info = env.step(f"open {t}")
+            f, s = futile_of(info)
+            if str(obs).strip().startswith("Nothing happens"):
+                continue  # retry did not actually succeed; inconclusive
+            if not f and s == 0:
+                return "PASS"
+            return f"FAIL: successful retry 'open {t}' after 'go to {t}' flagged (futile={f}, streak={s})"
+        if done:
+            continue
+    return f"SKIP: no openable receptacle reachable for the retry pattern in {MAX_GAMES} games"
+
+
+def main():
+    env = SingleEnv(seed=0)
+    patterns = [
+        ("a: repeat examine escalates streak", pattern_a),
+        ("b: round trip does not exempt", pattern_b),
+        ("c: changed slice exempts repeat", pattern_c),
+        ("d: first execution never flagged", pattern_d),
+        ("e: position change exempts retry", pattern_e),
+    ]
+    results = []
+    try:
+        for name, fn in patterns:
+            try:
+                verdict = fn(env)
+            except TrackerKeysMissing as exc:
+                verdict = f"FAIL: {exc}"
+            except Exception as exc:  # keep going so all patterns report
+                verdict = f"FAIL: unexpected exception {exc!r}"
+            results.append((name, verdict))
+            print(f"[{verdict.split(':')[0]}] pattern {name} -> {verdict}")
+    finally:
+        env.close()
+
+    failed = [name for name, v in results if v.startswith("FAIL")]
+    print()
+    for name, verdict in results:
+        print(f"  pattern {name}: {verdict}")
+    if failed:
+        print(f"\n{len(failed)} pattern(s) FAILED: {failed}")
+        sys.exit(1)
+    print("\nAll required patterns passed.")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
