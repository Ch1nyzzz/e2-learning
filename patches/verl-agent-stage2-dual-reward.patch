+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Per-episode "futile repetition" detector for the ALFWorld TextWorld env.
+
+An executed action a is FUTILE at step t iff:
+  1. a (normalized string) was executed before in this episode at some t' < t;
+  2. that execution at t' was a state no-op (see _is_noop);
+  3. the entity slice of a, snapshotted AFTER the execution at t' (post-state),
+     equals the entity slice of a at decision time t.
+First-time mistakes are never penalized; a repeat is exempt as soon as the
+action's entity slice (or the inventory, or the agent's position) has changed
+since the failed attempt.
+
+Facts arrive already demangled: PddlEnv._get_human_readable_fact maps every
+fact argument id through entity_infos[id].name, and AlfredDemangler rewrites
+those names to 'cabinet 1'-style strings at load time. So action-text entity
+names match fact argument names directly (modulo the trailing space that
+demangling leaves on unnumbered entities like 'agent1 ' / 'loc 3' -> we strip).
+"""
+
+import re
+
+
+class FutileTracker:
+    """Tracks futile repetitions within one episode of one env instance.
+
+    Usage (around env.step):
+        futile, streak = tracker.pre_step(action, facts_before_step)
+        obs, ... = env.step(action)
+        tracker.post_step(action, feedback, facts_before_step, facts_after_step)
+    """
+
+    # Epistemic markers (from the alfred.pddl predicate list): 'checked' is
+    # added by examine/inventory/open, 'examined' is declared for locations.
+    # A diff containing ONLY these is knowledge-gain, not a world-state change,
+    # but strict facts-equality would misclassify e.g. the first examine.
+    # The 'not_' variants are the negated forms textworld emits for deletes.
+    EPISTEMIC_PREDICATES = frozenset(
+        {"checked", "examined", "not_checked", "not_examined"})
+
+    # Facts describing what the agent holds (verified empirically: take adds
+    # holds/holdsany, put adds not_holds/not_holdsany; the domain also declares
+    # holdsAnyReceptacleObject). Always unioned into every entity slice so an
+    # inventory change exempts repeats like returning to the fridge to cool.
+    INVENTORY_PREDICATES = frozenset({
+        "holds", "holdsany", "holdsanyreceptacleobject",
+        "not_holds", "not_holdsany", "not_holdsanyreceptacleobject",
+    })
+
+    # The agent's own position: 'atlocation agent1 loc N' (agent-only in
+    # alfred.pddl; receptacles/objects use receptacleatlocation and
+    # objectatlocation). Always unioned into every entity slice so a retry
+    # from a different position is exempt: a no-op recorded from the wrong
+    # spot (e.g. 'open drawer 2' from afar -> 'Nothing happens') must not
+    # flag the now-effective retry after 'go to drawer 2'. Deliberately
+    # WITHOUT 'not_atlocation': those negated markers persist for every
+    # location the agent has ever left (verified empirically), so including
+    # them would turn the slice into a visit history and wrongly exempt
+    # round-trip repeats.
+    AGENT_POSITION_PREDICATES = frozenset({"atlocation"})
+
+    # Verbs whose observed command templates carry one/two entity arguments
+    # (vocabulary confirmed against recorded rollouts: go to X, examine X,
+    # open/close X, take X from Y, move X to Y, use X, heat/cool/clean X with
+    # Y; 'put X in/on Y' and 'slice X with Y' kept for template completeness).
+    _ACTION_PATTERNS = [
+        re.compile(r"^go to (?P<a>.+)$"),
+        re.compile(r"^examine (?P<a>.+)$"),
+        re.compile(r"^open (?P<a>.+)$"),
+        re.compile(r"^close (?P<a>.+)$"),
+        re.compile(r"^use (?P<a>.+)$"),
+        re.compile(r"^take (?P<a>.+) from (?P<b>.+)$"),
+        re.compile(r"^move (?P<a>.+) to (?P<b>.+)$"),
+        re.compile(r"^put (?P<a>.+) in/on (?P<b>.+)$"),
+        re.compile(r"^heat (?P<a>.+) with (?P<b>.+)$"),
+        re.compile(r"^cool (?P<a>.+) with (?P<b>.+)$"),
+        re.compile(r"^clean (?P<a>.+) with (?P<b>.+)$"),
+        re.compile(r"^slice (?P<a>.+) with (?P<b>.+)$"),
+    ]
+
+    def __init__(self):
+        self.reset()
+
+    def reset(self):
+        # normalized action -> set of post-state entity slices recorded at
+        # each no-op execution of that action ("at some t'" is existential).
+        self._noop_slices = {}
+        self._streak = 0
+
+    def pre_step(self, action_text, current_facts):
+        """Decide, before executing, whether repeating `action_text` is futile.
+
+        Returns (futile, streak); streak is the 1-based consecutive-futile
+        index, 0 when not futile. Never raises: degrades to (False, 0).
+        """
+        try:
+            futile = self._is_futile(action_text, current_facts)
+        except Exception:
+            futile = False
+        if futile:
+            self._streak += 1
+        else:
+            self._streak = 0
+        return futile, self._streak
+
+    def post_step(self, action_text, feedback_text, pre_facts, post_facts):
+        """Record the execution outcome; call after env.step. Never raises."""
+        try:
+            targets = self._parse_targets(action_text)
+            if targets is None or post_facts is None:
+                return
+            if self._is_noop(feedback_text, pre_facts, post_facts):
+                key = self._normalize(action_text)
+                slices = self._noop_slices.setdefault(key, set())
+                # POST-state snapshot convention: includes epistemic markers
+                # (e.g. checked) gained at t', so the very next identical
+                # repeat already matches and gets flagged.
+                slices.add(self._entity_slice(post_facts, targets))
+        except Exception:
+            pass
+
+    # ------------------------------------------------------------------ #
+
+    def _is_futile(self, action_text, current_facts):
+        targets = self._parse_targets(action_text)
+        if targets is None or current_facts is None:
+            return False
+        recorded = self._noop_slices.get(self._normalize(action_text))
+        if not recorded:
+            return False
+        return self._entity_slice(current_facts, targets) in recorded
+
+    @staticmethod
+    def _normalize(action_text):
+        return " ".join(str(action_text).strip().lower().split())
+
+    @classmethod
+    def _parse_targets(cls, action_text):
+        """Target entity names of an action, or None if the action can never
+        be futile (look/inventory/other argument-less or unparseable text)."""
+        action = cls._normalize(action_text)
+        for pattern in cls._ACTION_PATTERNS:
+            match = pattern.match(action)
+            if match:
+                return frozenset(v.strip() for v in match.groupdict().values() if v)
+        return None
+
+    @staticmethod
+    def _fact_keys(facts):
+        """Facts as hashable (predicate, arg-names) pairs. Accepts textworld
+        Proposition objects or already-converted (name, args) tuples."""
+        keys = set()
+        for fact in facts:
+            if isinstance(fact, tuple):
+                name, args = fact
+                keys.add((name, tuple(str(a).strip() for a in args)))
+            else:
+                keys.add((fact.name,
+                          tuple(str(a.name).strip() for a in fact.arguments)))
+        return keys
+
+    @classmethod
+    def _entity_slice(cls, facts, targets):
+        return frozenset(
+            key for key in cls._fact_keys(facts)
+            if key[0] in cls.INVENTORY_PREDICATES
+            or key[0] in cls.AGENT_POSITION_PREDICATES
+            or any(arg in targets for arg in key[1]))
+
+    @classmethod
+    def _is_noop(cls, feedback_text, pre_facts, post_facts):
+        if str(feedback_text).strip().startswith("Nothing happens"):
+            return True
+        if pre_facts is None:
+            return False
+        diff = cls._fact_keys(pre_facts) ^ cls._fact_keys(post_facts)
+        return all(key[0] in cls.EPISTEMIC_PREDICATES for key in diff)
