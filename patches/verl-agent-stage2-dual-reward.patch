+"""
+
+# Stage-2 variants (selected via env.stage2_prompt): identical to the templates above
+# except for one extra history-review sentence. Derived via replace so the base text
+# can never drift out of sync.
+_STAGE2_HISTORY_SENTENCE = (
+    "In your reasoning, first briefly review your interaction history — what you have already tried "
+    "and what each attempt revealed — and take it into account when choosing your next action."
+)
+
+ALFWORLD_TEMPLATE_NO_HIS_STAGE2 = ALFWORLD_TEMPLATE_NO_HIS.replace(
+    "You should first reason step-by-step about the current situation.",
+    "You should first reason step-by-step about the current situation. " + _STAGE2_HISTORY_SENTENCE,
+)
+
+ALFWORLD_TEMPLATE_STAGE2 = ALFWORLD_TEMPLATE.replace(
+    "You should first reason step-by-step about the current situation.",
+    "You should first reason step-by-step about the current situation. " + _STAGE2_HISTORY_SENTENCE,
+)
+
+# --------------------- ALFWorld e2l format (env.prompt_format=e2l) --------------------- #
+# Verbatim port of the e2-learning Stage-1 policy prompt
+# (src/experience_learning/prompts.py: POLICY_SYSTEM_PROMPT + policy_messages).
+# Rendered as a system+user message pair so apply_chat_template produces the exact
+# structure the cold-start checkpoints were trained and offline-evaluated on.
+ALFWORLD_E2L_SYSTEM_PROMPT = """You are an agent solving a household task in the deterministic
+ALFWorld text environment. Use the task, observations, and action history to make progress toward
+the goal. Choose exactly one command from the supplied admissible actions. Briefly reason inside
+<think>...</think>, then return the command verbatim inside <action>...</action>. Do not predict the
+next observation and do not return more than one action."""
+
+ALFWORLD_E2L_SYSTEM_PROMPT_STAGE2 = ALFWORLD_E2L_SYSTEM_PROMPT + " " + _STAGE2_HISTORY_SENTENCE
+
+
+def alfworld_e2l_user_prompt(initial_observation, history_steps, admissible_actions):
+    """Render the e2l user message: render_transcript layout + admissible action list.
+
+    history_steps: (action, resulting_observation) pairs, window already applied;
+    step numbers restart at 1 within the window, matching e2-learning's
+    render_transcript over a truncated history.
+    """
+    parts = [f"INITIAL OBSERVATION:\n{initial_observation}"]
+    for index, (action, observation) in enumerate(history_steps, start=1):
+        parts.append(f"STEP {index}\nACTION: {action}\nOBSERVATION: {observation}")
+    transcript = "\n\n".join(parts)
+    action_list = "\n".join(f"- {action}" for action in admissible_actions)
+    return (
+        f"{transcript}\n\nADMISSIBLE ACTIONS:\n{action_list}\n\n"
+        "Select the single best next action."
+    )
